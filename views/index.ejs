<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Szállásfoglalás
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <h1>Szállásfoglalás</h1>
        <form method="post">
            <div class="input-group">
                <label for="nameInput">Nev</label>
                <input
                type="text"
                name="name"
                id="nameInput"
                value="<%=locals.nameValue%>"
                >
            </div>
            <div class="input-group">
                <label for="emailInput">Email cim</label>
                <input
                type="email"
                name="email"
                id="emailInput"
                value="<%=locals.emailValue%>"
                >
            </div>
            <div class="input-group">
                <label for="dateInput">Idopont</label>
                <input
                type="datetime-local"
                name="date"
                id="dateInput"
                value="<%=locals.dateValue%>"
                >
            </div>
            <div class="input-group">
                <label for="guestsInput">Vendegek szama</label>
                <input
                type="number"
                name="guests"
                id="guestsInput"
                value="<%=locals.guestsValue%>"
                >
            </div>
            <input type="submit" value="Foglalas">
        </form>
    </div>

</body>

</html>