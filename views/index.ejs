<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Szállásfoglalás
    </title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.9/css/bootstrap.min.css"
        integrity="sha512-ZuV2yPmu5OcwTgfUHURSM2QYEMPA9UIPpMr/U9gJEdRB+1VcCJaUc/GJrO9WwZVNR3JB7mgzkRtRwor+BcaPAA=="
        crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <p>Jelenlegi foglalasok szama: <%=locals.count%>
        </p>
        <h1>Szállásfoglalás</h1>
        <form method="post">
            <div class="input-group">
                <label for="nameInput">Nev</label>
                <input type="text" name="name" id="nameInput" value="<%=locals.nameValue%>">
                <% if (locals.errNameMess) { %>
                    <div class="err-box">
                        <p class="err-mess">
                            <%=locals.errNameMess%>
                        </p>
                    </div>
                    <%}%>
            </div>
            <div class="input-group">
                <label for="emailInput">Email cim</label>
                <input type="email" name="email" id="emailInput" value="<%=locals.emailValue%>">
                <% if (locals.errEmailMess) { %>
                    <div class="err-box">
                        <p class="err-mess">
                            <%=locals.errEmailMess%>
                        </p>
                    </div>
                    <%}%>

            </div>
            <div class="input-group">
                <label for="dateInput">Idopont</label>
                <input type="datetime-local" name="date" id="dateInput" value="<%=locals.dateValue%>">
                <% if (locals.errDateMess) { %>
                    <div class="err-box">
                        <p class="err-mess">
                            <%=locals.errDateMess%>
                        </p>
                    </div>
                    <%}%>

            </div>
            <div class="input-group">
                <label for="guestsInput">Vendegek szama</label>
                <input type="number" name="guests" id="guestsInput" value="<%=locals.guestsValue%>">
                <% if (locals.errGuestsMess) { %>
                    <div class="err-box">
                        <p class="err-mess">
                            <%=locals.errGuestsMess%>
                        </p>
                    </div>
                    <%}%>
            </div>
            <input type="submit" value="Foglalas">
            <% if (locals.errMess) { %>
                <div class="err-box">
                    <p class="err-mess">
                        <%=locals.errMess%>
                    </p>
                </div>
                <%}%>
        </form>
        <% if (locals.success) { %>
            <div class="success-box">
                <p class="success-mess">
                    Sikeres feltoltes
                </p>
            </div>
            <%}%>
    </div>

</body>

</html>