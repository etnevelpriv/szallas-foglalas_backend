<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Szállásfoglalás
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="container">
        <h1>Szállásfoglalás</h1>
        <form method="post">
            <div class="input-group">
                <label for="nameInput">Nev</label>
                <input type="text" required name="name" id="nameInput">
            </div>
            <div class="input-group">
                <label for="emailInput">Email cim</label>
                <input type="email" required name="email" id="emailInput">
            </div>
            <div class="input-group">
                <label for="dateInput">Idopont</label>
                <input type="datetime-local" required name="date" id="dateInput">
            </div>
            <div class="input-group">
                <label for="guestsInput">Vendegek szama</label>
                <input type="number" required name="guests" id="guestsInput">
            </div>
            <input type="submit" value="Foglalas">
        </form>
    </div>

</body>

</html>